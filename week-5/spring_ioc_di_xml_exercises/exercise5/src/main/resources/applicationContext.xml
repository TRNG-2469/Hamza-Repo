<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    <bean id="smsMessageService" class="com.rev.sp.SMSMessageService"/>
    <bean id="emailMessageService" class="com.rev.sp.EmailMessageService"/>

    <bean id="notificationService" class="com.rev.sp.NotificationService">
        <constructor-arg ref="emailMessageService"/>
    </bean>
</beans>